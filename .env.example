# Copy to .env and fill in. .env is gitignored and never committed. NFR-SEC-01, NFR-SEC-03.
# No value in this file is real.

# --- Datastore: Supabase Postgres with pgvector ---
# Supabase dashboard > Connect (top bar) > Session pooler > URI.
# New projects have no direct db.PROJECT_REF.supabase.co host; that name does not
# resolve. Use the session pooler on port 5432. The username carries the project
# ref after a dot. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# --- Generation and embeddings: Azure OpenAI (primary). D-018 ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Deployment names as they appear in Azure AI Foundry, not the model names.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Generation fallback: Google Gemini. D-034 ---
# Free tier only. Google may use free-tier inputs and outputs to train their
# models, so this path carries an exposure Azure does not. Used only when Azure
# is unavailable, and never for embeddings, because a second embedding space
# would silently break retrieval.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Voice: ElevenLabs primary, Fish Audio fallback. D-009, FR-20 ---
# Both speech-to-text and text-to-speech run server-side. A browser-side call
# would put these keys in the page.
ELEVENLABS_API_KEY=
# Voice id from the ElevenLabs voice library. Pick one and keep it stable, or a
# cached answer synthesised yesterday will not match today's voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_SPANISH=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

FISH_AUDIO_API_KEY=
# Fish calls this reference_id. Leave blank for their default voice.
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_VOICE_ID_SPANISH=

# --- Corpus ---
# Contract, plans and county the corpus is scoped to. D-033.

GCP_PROJECT_ID=
