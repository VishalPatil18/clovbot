# Copy to .env and fill in. .env is gitignored and never committed.
# No value in this file is real.

# --- Datastore: Supabase Postgres with pgvector ---
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
DATABASE_APP_URL=postgresql://clovbot_app.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# --- Generation and embeddings: Azure OpenAI (primary). D-018 ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Generation fallback: Google Gemini. D-034 ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Voice: ElevenLabs primary, Fish Audio fallback. D-009, FR-20 ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_SPANISH=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_VOICE_ID_SPANISH=

# --- Miscellaneous ---
GCP_PROJECT_ID=
RESEND_API_KEY=
OPERATOR_MEMBER_EMAILS=
OTP_FROM_ADDRESS="Clovbot <clovbot@v-ai.org>"
